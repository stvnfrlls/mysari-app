APP_NAME=MySari-App
IMAGE_NAME=mysari-app
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sariapp
DB_USERNAME=sariapp_user
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=predis
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

TRUSTED_PROXIES=*
TEST_DB_SWITCH=false
